{
  "name": "cfp_website_workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend and backend launch commands for CFP Website",
  "scripts": {
    "setup": "npm --prefix backend ci",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "migrate": "npm --prefix backend run migrate",
    "seed:admin": "npm --prefix backend run seed:admin --",
    "test": "npm --prefix backend test",
    "verify:frontend": "node tools/verify-enquiry-form.cjs && node tools/verify-product-information.cjs"
  }
}
