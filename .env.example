# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security and Sessions
JWT_SECRET=replace_with_a_secure_random_64_char_secret_in_production
SESSION_SECRET=replace_with_another_secure_secret_in_production
COOKIE_SECURE=false

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cfp_store

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_change_in_production
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Shiprocket Shipping Integration (Test Mode / Production)
SHIPROCKET_EMAIL=shipping@choudharifarmproducts.com
SHIPROCKET_PASSWORD=placeholder_shiprocket_password
SHIPROCKET_WEBHOOK_SECRET=placeholder_shiprocket_webhook_secret

# Transactional Email Notification Service
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@choudharifarmproducts.com
SMTP_PASS=placeholder_smtp_password
EMAIL_FROM="Choudhari Farm Products" <orders@choudharifarmproducts.com>
SUPPORT_EMAIL=chaudharifarmproducts@gmail.com
SUPPORT_PHONE=+91 97646 58181
